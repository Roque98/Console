@{
    ViewData["Title"] = "Biblioteca de Prompts - SmartPromptLibrary";
}

<link rel="stylesheet" href="~/adminLTE/bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="~/adminLTE/bower_components/select2/dist/css/select2.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">

<style>
    .prompt-card {
        cursor: pointer;
        transition: all 0.3s;
        border-left: 4px solid transparent;
    }

    .prompt-card:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }

    .prompt-card.favorito {
        border-left-color: #f39c12;
    }

    .badge-tag {
        font-size: 11px;
        padding: 4px 8px;
        margin: 2px;
        border-radius: 3px;
    }

    .markdown-preview {
        padding: 15px;
        background: #f9f9f9;
        border-radius: 4px;
        max-height: 400px;
        overflow-y: auto;
    }

    .variable-input {
        margin-bottom: 15px;
    }

    .execution-result {
        background: #f4f4f4;
        padding: 20px;
        border-radius: 4px;
        margin-top: 15px;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 18px;
        color: white;
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <h1>
            <i class="fa fa-book"></i> Biblioteca de Prompts
            <small>Gestión, refinamiento y prueba de prompts de IA</small>
        </h1>
    </section>

    <section class="content">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#tab-biblioteca" data-toggle="tab"><i class="fa fa-library"></i> Biblioteca</a></li>
                <li><a href="#tab-categorias" data-toggle="tab"><i class="fa fa-folder"></i> Categorías</a></li>
                <li><a href="#tab-etiquetas" data-toggle="tab"><i class="fa fa-tags"></i> Etiquetas</a></li>
                <li><a href="#tab-historial" data-toggle="tab"><i class="fa fa-history"></i> Historial de Ejecuciones</a></li>
            </ul>

            <div class="tab-content">
                <!-- Tab Biblioteca -->
                <div class="tab-pane active" id="tab-biblioteca">
                    <div class="box-header with-border">
                        <h3 class="box-title">Biblioteca de Prompts</h3>
                        <div class="pull-right">
                            <button type="button" class="btn btn-success" id="btnGenerarConIA">
                                <i class="fa fa-magic"></i> Generar con IA
                            </button>
                            <button type="button" class="btn btn-primary" id="btnNuevoPrompt">
                                <i class="fa fa-plus"></i> Nuevo Prompt
                            </button>
                        </div>
                    </div>
                    <div class="box-body">
                        <!-- Filtros -->
                        <div class="row" style="margin-bottom: 20px;">
                            <div class="col-md-4">
                                <input type="text" class="form-control" id="searchPrompts" placeholder="Buscar prompts...">
                            </div>
                            <div class="col-md-3">
                                <select class="form-control" id="filterCategoria">
                                    <option value="">Todas las categorías</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-control select2" id="filterEtiquetas" multiple="multiple" data-placeholder="Filtrar por etiquetas">
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-default btn-block" id="btnMostrarFavoritos">
                                    <i class="fa fa-star"></i> Favoritos
                                </button>
                            </div>
                        </div>

                        <!-- Lista de Prompts -->
                        <div class="row" id="promptsList"></div>
                    </div>
                </div>

                <!-- Tab Categorías -->
                <div class="tab-pane" id="tab-categorias">
                    <div class="box-header with-border">
                        <h3 class="box-title">Categorías de Prompts</h3>
                        <button type="button" class="btn btn-primary pull-right" id="btnNuevaCategoria">
                            <i class="fa fa-plus"></i> Nueva Categoría
                        </button>
                    </div>
                    <div class="box-body">
                        <table id="categoriasTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Descripción</th>
                                    <th>Icono</th>
                                    <th>Total Prompts</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab Etiquetas -->
                <div class="tab-pane" id="tab-etiquetas">
                    <div class="box-header with-border">
                        <h3 class="box-title">Etiquetas</h3>
                        <button type="button" class="btn btn-primary pull-right" id="btnNuevaEtiqueta">
                            <i class="fa fa-plus"></i> Nueva Etiqueta
                        </button>
                    </div>
                    <div class="box-body">
                        <table id="etiquetasTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Color</th>
                                    <th>Total Prompts</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab Historial -->
                <div class="tab-pane" id="tab-historial">
                    <div class="box-header with-border">
                        <h3 class="box-title">Historial de Ejecuciones</h3>
                    </div>
                    <div class="box-body">
                        <table id="historialTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Prompt</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Tokens</th>
                                    <th>Costo</th>
                                    <th>Tiempo (ms)</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal: Generar Prompt con IA -->
<div class="modal fade" id="modalGenerarIA" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-magic"></i> Generar Prompt con IA</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Describe tu idea general:</label>
                    <textarea class="form-control" id="ideaGeneral" rows="5" placeholder="Ejemplo: Necesito un prompt que ayude a generar descripciones de productos para e-commerce..."></textarea>
                </div>
                <div id="promptGenerado" style="display:none;">
                    <label>Prompt Generado:</label>
                    <div class="markdown-preview" id="promptGeneradoPreview"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnGenerarPrompt">
                    <i class="fa fa-magic"></i> Generar
                </button>
                <button type="button" class="btn btn-primary" id="btnUsarGenerado" style="display:none;">
                    <i class="fa fa-check"></i> Usar este Prompt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nuevo/Editar Prompt -->
<div class="modal fade" id="modalPrompt" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="modalPromptTitle">Nuevo Prompt</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="promptId">
                <div class="form-group">
                    <label>Título *</label>
                    <input type="text" class="form-control" id="promptTitulo" required>
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    <textarea class="form-control" id="promptDescripcion" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label>Categoría *</label>
                    <select class="form-control" id="promptCategoria" required></select>
                </div>
                <div class="form-group">
                    <label>Contenido Markdown *</label>
                    <textarea class="form-control" id="promptContenido" rows="12" style="font-family: monospace;"></textarea>
                    <small class="text-muted">
                        Usa {{'{{'}}variable{{'}}'}} o [VARIABLE] para parámetros dinámicos
                    </small>
                </div>
                <div class="form-group">
                    <label>Mensaje de Sistema (System Message)</label>
                    <textarea class="form-control" id="promptSistema" rows="3" placeholder="Ejemplo: Eres un experto desarrollador de software..."></textarea>
                </div>
                <div class="form-group">
                    <label>Etiquetas</label>
                    <div class="row">
                        <div class="col-md-10">
                            <select class="form-control select2" id="promptEtiquetas" multiple="multiple" data-placeholder="Seleccionar etiquetas"></select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-default btn-block" id="btnSugerirEtiquetas" title="Sugerir etiquetas con IA">
                                <i class="fa fa-magic"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="checkbox">
                    <label>
                        <input type="checkbox" id="promptFavorito"> Marcar como favorito
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarPrompt">
                    <i class="fa fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Ver/Ejecutar Prompt -->
<div class="modal fade" id="modalEjecutarPrompt" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="ejecutarPromptTitle"></h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ejecutarPromptId">

                <!-- Información del Prompt -->
                <div class="alert alert-info">
                    <strong>Descripción:</strong>
                    <p id="ejecutarPromptDescripcion"></p>
                    <div id="ejecutarPromptEtiquetas"></div>
                </div>

                <!-- Vista Previa del Contenido -->
                <div class="box box-default collapsed-box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Vista Previa del Prompt</h3>
                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="markdown-preview" id="ejecutarPromptContenido"></div>
                    </div>
                </div>

                <!-- Formulario de Parámetros -->
                <div id="parametrosContainer"></div>

                <!-- Resultado de la Ejecución -->
                <div id="resultadoEjecucion" style="display:none;">
                    <hr>
                    <h4><i class="fa fa-check-circle text-success"></i> Resultado de la Ejecución</h4>
                    <div class="execution-result" id="resultadoContenido"></div>
                    <div class="row" style="margin-top: 10px;">
                        <div class="col-md-3">
                            <small class="text-muted">Tokens usados: <strong id="resultadoTokens"></strong></small>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Costo estimado: <strong id="resultadoCosto"></strong></small>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Tiempo: <strong id="resultadoTiempo"></strong></small>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-sm btn-default btn-block" id="btnCopiarResultado">
                                <i class="fa fa-copy"></i> Copiar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-info" id="btnVerVersiones">
                    <i class="fa fa-history"></i> Versiones
                </button>
                <button type="button" class="btn btn-warning" id="btnEditarPrompt">
                    <i class="fa fa-edit"></i> Editar
                </button>
                <button type="button" class="btn btn-primary" id="btnEjecutarPrompt">
                    <i class="fa fa-play"></i> Ejecutar Prompt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Ver Detalles de Ejecución -->
<div class="modal fade" id="modalDetalleEjecucion" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Detalle de Ejecución</h4>
            </div>
            <div class="modal-body">
                <div id="detalleEjecucionContenido"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Historial de Versiones -->
<div class="modal fade" id="modalVersiones" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="fa fa-history"></i> Historial de Versiones
                    <small id="versionesPromptTitulo"></small>
                </h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="versionesPromptId">

                <!-- Lista de versiones -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Versión</th>
                                <th>Título</th>
                                <th>Mensaje de Cambio</th>
                                <th>Usuario</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="versionesTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Ver Detalle de Versión -->
<div class="modal fade" id="modalDetalleVersion" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="fa fa-file-text"></i> Versión <span id="detalleVersionNumero"></span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <dl class="dl-horizontal">
                            <dt>Título:</dt>
                            <dd id="detalleVersionTitulo"></dd>
                            <dt>Descripción:</dt>
                            <dd id="detalleVersionDescripcion"></dd>
                            <dt>Mensaje de Cambio:</dt>
                            <dd id="detalleVersionMensajeCambio"></dd>
                            <dt>Creado por:</dt>
                            <dd id="detalleVersionUsuario"></dd>
                            <dt>Fecha:</dt>
                            <dd id="detalleVersionFecha"></dd>
                        </dl>
                    </div>
                </div>

                <hr>

                <h4>Contenido del Prompt</h4>
                <div class="markdown-preview" id="detalleVersionContenido"></div>

                <hr>

                <h4>Mensaje de Sistema</h4>
                <pre style="background: #f4f4f4; padding: 15px; border-radius: 4px;"><code id="detalleVersionMensajeSistema"></code></pre>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="detalleVersionId">
                <input type="hidden" id="detalleVersionIdPrompt">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-warning" id="btnRestaurarVersion">
                    <i class="fa fa-undo"></i> Restaurar esta Versión
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Guardar como Nueva Versión -->
<div class="modal fade" id="modalGuardarVersion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="fa fa-save"></i> Guardar como Nueva Versión
                </h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="guardarVersionPromptId">
                <div class="form-group">
                    <label>Mensaje de Cambio</label>
                    <textarea class="form-control" id="guardarVersionMensaje" rows="3"
                              placeholder="Describe los cambios realizados en esta versión..." required></textarea>
                    <small class="text-muted">Explica qué cambios se hicieron en esta versión del prompt</small>
                </div>
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Se guardará el contenido actual del prompt como una nueva versión.
                    La versión anterior quedará disponible en el historial.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarGuardarVersion">
                    <i class="fa fa-save"></i> Guardar Versión
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/adminLTE/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/adminLTE/bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
<script src="~/adminLTE/bower_components/select2/dist/js/select2.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/showdown/2.1.0/showdown.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="~/js/smart-prompt-library.js"></script>
<script src="~/js/smart-prompt-versions.js"></script>
