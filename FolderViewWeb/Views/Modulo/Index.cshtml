@{
    ViewData["Title"] = "Módulos - Administración Bot";
}

<link rel="stylesheet" href="~/adminLTE/bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="~/adminLTE/bower_components/select2/dist/css/select2.min.css">

<div class="content-wrapper">
    <section class="content-header">
        <h1>Gestión de Módulos</h1>
    </section>

    <section class="content">
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title">Lista de Módulos</h3>
                <button type="button" class="btn btn-primary pull-right" id="btnNuevo">
                    <i class="fa fa-plus"></i> Nuevo Módulo
                </button>
            </div>
            <div class="box-body">
                <table id="modulosTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Icono</th>
                            <th>Orden</th>
                            <th>Comandos</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<!-- Modal -->
<div class="modal fade" id="moduloModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="modalTitle">Nuevo Módulo</h4>
            </div>
            <div class="modal-body">
                <form id="moduloForm">
                    <input type="hidden" id="idModulo">
                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" class="form-control" id="nombre" required>
                    </div>
                    <div class="form-group">
                        <label>Descripción *</label>
                        <textarea class="form-control" id="descripcion" rows="3" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Icono *</label>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-question" id="iconoPreview"></i>
                            </span>
                            <select class="form-control select2" id="icono" style="width: 100%;">
                                <option value="">Seleccione un icono...</option>
                            </select>
                        </div>
                        <small class="text-muted">Busque y seleccione un icono de la lista</small>
                    </div>
                    <div class="form-group">
                        <label>Orden</label>
                        <input type="number" class="form-control" id="orden" value="1">
                    </div>
                    <div class="form-group">
                        <label>Estado</label>
                        <select class="form-control" id="activo">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/adminLTE/bower_components/select2/dist/js/select2.full.min.js"></script>
<script>
    $(document).ready(function () {
        let iconosData = [];

        // Cargar iconos desde la API
        function cargarIconos() {
            $.get('/api/iconos', function(data) {
                iconosData = data;
                let $select = $('#icono');
                $select.empty();
                $select.append('<option value="">Seleccione un icono...</option>');

                // Agrupar por categoría
                let categorias = {};
                data.forEach(function(icono) {
                    if (!categorias[icono.categoria]) {
                        categorias[icono.categoria] = [];
                    }
                    categorias[icono.categoria].push(icono);
                });

                // Agregar opciones agrupadas
                Object.keys(categorias).sort().forEach(function(categoria) {
                    let $optgroup = $('<optgroup label="' + categoria + '"></optgroup>');
                    categorias[categoria].forEach(function(icono) {
                        $optgroup.append(
                            `<option value="${icono.clase}" data-icon="${icono.clase}">
                                ${icono.nombre} - ${icono.descripcion || ''}
                            </option>`
                        );
                    });
                    $select.append($optgroup);
                });

                // Inicializar Select2 con template personalizado
                $select.select2({
                    templateResult: formatIcono,
                    templateSelection: formatIconoSelection,
                    width: '100%',
                    placeholder: 'Busque un icono...',
                    allowClear: true
                });
            });
        }

        // Formato para mostrar iconos en el dropdown
        function formatIcono(icono) {
            if (!icono.id) return icono.text;
            let $icono = $(
                '<span><i class="fa ' + $(icono.element).val() + '"></i> ' + icono.text + '</span>'
            );
            return $icono;
        }

        // Formato para mostrar el icono seleccionado
        function formatIconoSelection(icono) {
            if (!icono.id) return icono.text;
            return icono.text;
        }

        // Actualizar vista previa del icono
        $('#icono').on('change', function() {
            let iconoClase = $(this).val();
            if (iconoClase) {
                $('#iconoPreview').attr('class', 'fa ' + iconoClase);
            } else {
                $('#iconoPreview').attr('class', 'fa fa-question');
            }
        });

        // Cargar iconos al iniciar
        cargarIconos();

        let table = $('#modulosTable').DataTable({
            ajax: {
                url: '/api/modulos',
                dataSrc: ''
            },
            columns: [
                { data: 'idModulo' },
                { data: 'nombre' },
                { data: 'descripcion' },
                {
                    data: 'icono',
                    render: function(data) {
                        return `<i class="fa ${data}"></i> ${data}`;
                    }
                },
                { data: 'orden' },
                {
                    data: 'totalOperaciones',
                    render: function(data, type, row) {
                        if (data > 0) {
                            return `<a href="/Operacion?modulo=${row.idModulo}" class="badge bg-blue" title="Ver comandos de este módulo">
                                ${data} <i class="fa fa-external-link"></i>
                            </a>`;
                        }
                        return '<span class="badge bg-gray">0</span>';
                    }
                },
                {
                    data: 'activo',
                    render: function(data) {
                        return data ? '<span class="label label-success">Activo</span>' : '<span class="label label-danger">Inactivo</span>';
                    }
                },
                {
                    data: null,
                    render: function(data) {
                        return `
                            <button class="btn btn-sm btn-info btnVerComandos" data-id="${data.idModulo}" data-nombre="${data.nombre}" title="Ver comandos">
                                <i class="fa fa-list"></i>
                            </button>
                            <button class="btn btn-sm btn-warning btnEditar" data-id="${data.idModulo}" title="Editar">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger btnEliminar" data-id="${data.idModulo}" title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
            }
        });

        $('#btnNuevo').click(function() {
            $('#modalTitle').text('Nuevo Módulo');
            $('#moduloForm')[0].reset();
            $('#idModulo').val('');
            $('#icono').val('').trigger('change');
            $('#iconoPreview').attr('class', 'fa fa-question');
            $('#moduloModal').modal('show');
        });

        $(document).on('click', '.btnEditar', function() {
            const id = $(this).data('id');
            $.get(`/api/modulos/${id}`, function(data) {
                $('#modalTitle').text('Editar Módulo');
                $('#idModulo').val(data.idModulo);
                $('#nombre').val(data.nombre);
                $('#descripcion').val(data.descripcion);
                $('#icono').val(data.icono).trigger('change');
                $('#iconoPreview').attr('class', 'fa ' + data.icono);
                $('#orden').val(data.orden);
                $('#activo').val(data.activo.toString());
                $('#moduloModal').modal('show');
            });
        });

        $('#btnGuardar').click(function() {
            const id = $('#idModulo').val();
            const url = id ? `/api/modulos/${id}` : '/api/modulos';
            const method = id ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify({
                    idModulo: id || 0,
                    nombre: $('#nombre').val(),
                    descripcion: $('#descripcion').val(),
                    icono: $('#icono').val(),
                    orden: parseInt($('#orden').val()),
                    activo: $('#activo').val() === 'true'
                }),
                success: function() {
                    $('#moduloModal').modal('hide');
                    table.ajax.reload();
                }
            });
        });

        $(document).on('click', '.btnEliminar', function() {
            if (confirm('¿Está seguro de eliminar este módulo?')) {
                const id = $(this).data('id');
                $.ajax({
                    url: `/api/modulos/${id}`,
                    type: 'DELETE',
                    success: function() {
                        table.ajax.reload();
                    }
                });
            }
        });

        $(document).on('click', '.btnVerComandos', function() {
            const id = $(this).data('id');
            const nombre = $(this).data('nombre');
            window.location.href = `/Operacion?modulo=${id}&nombre=${encodeURIComponent(nombre)}`;
        });
    });
</script>
