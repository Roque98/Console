@{
    ViewData["Title"] = "Cuentas Telegram - Administración Bot";
}

<link rel="stylesheet" href="~/adminLTE/bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">

<div class="content-wrapper">
    <section class="content-header">
        <h1>Gestión de Cuentas de Telegram</h1>
    </section>

    <section class="content">
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title">Cuentas Vinculadas</h3>
                <button type="button" class="btn btn-warning pull-right" id="btnPendientes">
                    <i class="fa fa-clock-o"></i> Ver Pendientes de Verificación
                </button>
            </div>
            <div class="box-body">
                <table id="cuentasTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Telegram</th>
                            <th>Chat ID</th>
                            <th>Estado</th>
                            <th>Principal</th>
                            <th>Verificado</th>
                            <th>Última Actividad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<script>
    $(document).ready(function () {
        let table = $('#cuentasTable').DataTable({
            ajax: {
                url: '/api/telegram-accounts',
                dataSrc: ''
            },
            columns: [
                { data: 'usuario' },
                {
                    data: null,
                    render: function(data) {
                        return `@@${data.telegramUsername}<br><small>${data.telegramFirstName} ${data.telegramLastName || ''}</small>`;
                    }
                },
                { data: 'telegramChatId' },
                {
                    data: 'estado',
                    render: function(data) {
                        const colors = { ACTIVO: 'success', SUSPENDIDO: 'warning', BLOQUEADO: 'danger' };
                        return `<span class="label label-${colors[data]}">${data}</span>`;
                    }
                },
                {
                    data: 'esPrincipal',
                    render: function(data) {
                        return data ? '<i class="fa fa-star text-yellow"></i>' : '';
                    }
                },
                {
                    data: 'verificado',
                    render: function(data) {
                        return data ? '<i class="fa fa-check text-green"></i>' : '<i class="fa fa-times text-red"></i>';
                    }
                },
                {
                    data: 'fechaUltimaActividad',
                    render: function(data) {
                        return data ? new Date(data).toLocaleString() : 'N/A';
                    }
                },
                {
                    data: null,
                    render: function(data) {
                        let btns = '';
                        if (!data.verificado) {
                            btns += `<button class="btn btn-xs btn-success btnVerificar" data-id="${data.idUsuarioTelegram}">
                                <i class="fa fa-check"></i> Verificar
                            </button> `;
                        }
                        btns += `<button class="btn btn-xs btn-warning btnCambiarEstado" data-id="${data.idUsuarioTelegram}">
                            <i class="fa fa-exchange"></i> Estado
                        </button>`;
                        return btns;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
            }
        });

        $(document).on('click', '.btnVerificar', function() {
            if (confirm('¿Verificar esta cuenta?')) {
                const id = $(this).data('id');
                $.post(`/api/telegram-accounts/${id}/verificar`, function() {
                    table.ajax.reload();
                    alert('Cuenta verificada');
                });
            }
        });

        $(document).on('click', '.btnCambiarEstado', function() {
            const id = $(this).data('id');
            const nuevoEstado = prompt('Nuevo estado (ACTIVO/SUSPENDIDO/BLOQUEADO):');
            if (nuevoEstado) {
                $.ajax({
                    url: `/api/telegram-accounts/${id}/estado`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ estado: nuevoEstado.toUpperCase() }),
                    success: function() {
                        table.ajax.reload();
                    }
                });
            }
        });

        $('#btnPendientes').click(function() {
            $.get('/api/telegram-accounts/pendientes-verificacion', function(data) {
                if (data.length === 0) {
                    alert('No hay cuentas pendientes de verificación');
                    return;
                }
                let html = '<h4>Cuentas Pendientes:</h4><ul>';
                data.forEach(function(c) {
                    html += `<li>${c.usuario} - @@${c.telegramUsername} (${c.horasSinVerificar}h sin verificar)</li>`;
                });
                html += '</ul>';
                alert(html);
            });
        });
    });
</script>
