@{
    ViewData["Title"] = "Dashboard - Administración Bot";
}

<div class="content-wrapper">
    <!-- Content Header -->
    <section class="content-header">
        <h1>
            Dashboard
            <small>Panel de control del bot</small>
        </h1>
    </section>

    <!-- Main content -->
    <section class="content">
        <!-- Info boxes -->
        <div class="row">
            <div class="col-md-3 col-sm-6 col-xs-12">
                <div class="info-box">
                    <span class="info-box-icon bg-aqua"><i class="fa fa-users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Usuarios Activos</span>
                        <span class="info-box-number" id="totalUsuarios">0</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12">
                <div class="info-box">
                    <span class="info-box-icon bg-green"><i class="fa fa-telegram"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Cuentas Telegram</span>
                        <span class="info-box-number" id="usuariosConTelegram">0</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12">
                <div class="info-box">
                    <span class="info-box-icon bg-yellow"><i class="fa fa-bolt"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Operaciones Hoy</span>
                        <span class="info-box-number" id="operacionesHoy">0</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12">
                <div class="info-box">
                    <span class="info-box-icon bg-red"><i class="fa fa-book"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Knowledge Base</span>
                        <span class="info-box-number" id="entradasConocimiento">0</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Tasa de éxito -->
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Tasa de Éxito (Últimos 7 días)</h3>
                    </div>
                    <div class="box-body">
                        <canvas id="tasaExitoChart" style="height: 250px;"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top Operaciones -->
            <div class="col-md-6">
                <div class="box box-success">
                    <div class="box-header with-border">
                        <h3 class="box-title">Top 5 Operaciones</h3>
                    </div>
                    <div class="box-body">
                        <table class="table table-striped" id="topOperacionesTable">
                            <thead>
                                <tr>
                                    <th>Operación</th>
                                    <th>Comando</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Top Usuarios -->
            <div class="col-md-6">
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title">Top 5 Usuarios</h3>
                    </div>
                    <div class="box-body">
                        <table class="table table-striped" id="topUsuariosTable">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Operaciones</th>
                                    <th>Última Actividad</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Operaciones por resultado (hoy) -->
            <div class="col-md-6">
                <div class="box box-warning">
                    <div class="box-header with-border">
                        <h3 class="box-title">Operaciones Hoy por Resultado</h3>
                    </div>
                    <div class="box-body">
                        <canvas id="resultadosChart" style="height: 250px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
    $(document).ready(function () {
        cargarDashboard();

        function cargarDashboard() {
            // Cargar estadísticas generales
            $.get('/api/dashboard/stats', function (data) {
                $('#totalUsuarios').text(data.totalUsuarios);
                $('#usuariosConTelegram').text(data.usuariosConTelegram);
                $('#operacionesHoy').text(data.operacionesHoy);
                $('#entradasConocimiento').text(data.entradasConocimiento);
            });

            // Cargar top operaciones
            $.get('/api/dashboard/top-operaciones', function (data) {
                const tbody = $('#topOperacionesTable tbody');
                tbody.empty();
                data.forEach(function (item) {
                    tbody.append(`
                        <tr>
                            <td>${item.operacion}</td>
                            <td><code>${item.comando}</code></td>
                            <td><span class="badge bg-blue">${item.totalEjecuciones}</span></td>
                        </tr>
                    `);
                });
            });

            // Cargar top usuarios
            $.get('/api/dashboard/top-usuarios', function (data) {
                const tbody = $('#topUsuariosTable tbody');
                tbody.empty();
                data.forEach(function (item) {
                    tbody.append(`
                        <tr>
                            <td>${item.usuario}</td>
                            <td><span class="badge bg-green">${item.totalOperaciones}</span></td>
                            <td>${new Date(item.ultimaActividad).toLocaleString()}</td>
                        </tr>
                    `);
                });
            });

            // Cargar tasa de éxito
            $.get('/api/dashboard/tasa-exito', function (data) {
                const ctx = document.getElementById('tasaExitoChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.map(d => new Date(d.fecha).toLocaleDateString()),
                        datasets: [{
                            label: '% Éxito',
                            data: data.map(d => d.porcentajeExito),
                            borderColor: 'rgb(0, 166, 90)',
                            backgroundColor: 'rgba(0, 166, 90, 0.1)',
                            tension: 0.1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100
                            }
                        }
                    }
                });
            });

            // Cargar operaciones por resultado
            $.get('/api/dashboard/operaciones-resultado-hoy', function (data) {
                const ctx = document.getElementById('resultadosChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: data.map(d => d.resultado),
                        datasets: [{
                            data: data.map(d => d.cantidad),
                            backgroundColor: [
                                'rgb(0, 166, 90)',
                                'rgb(221, 75, 57)',
                                'rgb(243, 156, 18)'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            });
        }
    });
</script>
