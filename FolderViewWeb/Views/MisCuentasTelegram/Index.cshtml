@{
    ViewData["Title"] = "Mis Cuentas Telegram - Mi Cuenta";
}

<link rel="stylesheet" href="~/adminLTE/bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">

<div class="content-wrapper">
    <section class="content-header">
        <h1>
            Mis Cuentas de Telegram
            <small>Gestión de tus cuentas vinculadas</small>
        </h1>
    </section>

    <section class="content">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-telegram"></i> Mis Cuentas Vinculadas</h3>
            </div>
            <div class="box-body">
                <table id="cuentasTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Telegram</th>
                            <th>Chat ID</th>
                            <th>Estado</th>
                            <th>Principal</th>
                            <th>Verificado</th>
                            <th>Fecha Vinculación</th>
                            <th>Última Actividad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- Info adicional -->
        <div class="row">
            <div class="col-md-12">
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-info-circle"></i> Información Importante</h3>
                    </div>
                    <div class="box-body">
                        <ul>
                            <li>Solo puedes tener <strong>una cuenta principal</strong> a la vez.</li>
                            <li>La cuenta principal es la que se usa por defecto para las notificaciones del bot.</li>
                            <li>Puedes cambiar tu cuenta principal haciendo clic en "Marcar como Principal".</li>
                            <li>Las cuentas deben estar <strong>verificadas</strong> para poder recibir notificaciones.</li>
                            <li>Si una cuenta está suspendida o bloqueada, no recibirás notificaciones en ella.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Historial de Actividad -->
<div class="modal fade" id="modalActividad" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-history"></i> Historial de Actividad</h4>
            </div>
            <div class="modal-body" id="actividadContent">
                <p class="text-center"><i class="fa fa-spinner fa-spin"></i> Cargando...</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/adminLTE/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/adminLTE/bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        let table = $('#cuentasTable').DataTable({
            ajax: {
                url: '/api/mis-cuentas-telegram',
                dataSrc: ''
            },
            columns: [
                {
                    data: null,
                    render: function(data) {
                        return `
                            <strong>@@${data.telegramUsername}</strong><br>
                            <small>${data.telegramFirstName} ${data.telegramLastName || ''}</small>
                        `;
                    }
                },
                { data: 'telegramChatId' },
                {
                    data: 'estado',
                    render: function(data) {
                        const colors = {
                            'ACTIVO': 'success',
                            'SUSPENDIDO': 'warning',
                            'BLOQUEADO': 'danger'
                        };
                        return `<span class="label label-${colors[data]}">${data}</span>`;
                    }
                },
                {
                    data: 'esPrincipal',
                    render: function(data) {
                        return data
                            ? '<i class="fa fa-star text-yellow" title="Cuenta Principal"></i> <strong>SI</strong>'
                            : '<span class="text-muted">No</span>';
                    }
                },
                {
                    data: 'verificado',
                    render: function(data) {
                        return data
                            ? '<i class="fa fa-check-circle text-green"></i> Verificado'
                            : '<i class="fa fa-times-circle text-red"></i> Pendiente';
                    }
                },
                {
                    data: 'fechaCreacion',
                    render: function(data) {
                        return data ? new Date(data).toLocaleDateString('es-ES') : 'N/A';
                    }
                },
                {
                    data: 'fechaUltimaActividad',
                    render: function(data) {
                        if (!data) return '<span class="text-muted">Sin actividad</span>';
                        return new Date(data).toLocaleString('es-ES');
                    }
                },
                {
                    data: null,
                    render: function(data) {
                        let btns = '';

                        if (!data.esPrincipal && data.estado === 'ACTIVO' && data.verificado) {
                            btns += `
                                <button class="btn btn-xs btn-warning btnSetPrincipal"
                                        data-id="${data.idUsuarioTelegram}"
                                        title="Marcar como Principal">
                                    <i class="fa fa-star"></i> Principal
                                </button> `;
                        }

                        btns += `
                            <button class="btn btn-xs btn-info btnVerActividad"
                                    data-id="${data.idUsuarioTelegram}"
                                    title="Ver Historial">
                                <i class="fa fa-history"></i>
                            </button>`;

                        return btns;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
            },
            order: [[4, 'desc'], [6, 'desc']] // Ordenar por principal y luego por última actividad
        });

        // Marcar como principal
        $(document).on('click', '.btnSetPrincipal', function() {
            if (!confirm('¿Deseas marcar esta cuenta como principal? La cuenta principal actual dejará de serlo.')) {
                return;
            }

            const id = $(this).data('id');
            $.post(`/api/mis-cuentas-telegram/${id}/principal`, function(response) {
                if (response.success) {
                    table.ajax.reload();
                    toastr.success('Cuenta principal actualizada correctamente');
                } else {
                    toastr.error('Error al actualizar la cuenta principal');
                }
            }).fail(function() {
                toastr.error('Error al procesar la solicitud');
            });
        });

        // Ver historial de actividad
        $(document).on('click', '.btnVerActividad', function() {
            const id = $(this).data('id');
            $('#actividadContent').html('<p class="text-center"><i class="fa fa-spinner fa-spin"></i> Cargando...</p>');
            $('#modalActividad').modal('show');

            $.get(`/api/mis-cuentas-telegram/${id}/actividad`, function(data) {
                if (!data || data.length === 0) {
                    $('#actividadContent').html('<p class="text-muted">No hay actividad registrada para esta cuenta.</p>');
                    return;
                }

                let html = '<table class="table table-striped table-condensed">';
                html += '<thead><tr><th>Fecha/Hora</th><th>Operación</th><th>Resultado</th></tr></thead><tbody>';

                data.forEach(function(item) {
                    const exito = item.exito
                        ? '<span class="label label-success">Éxito</span>'
                        : '<span class="label label-danger">Error</span>';
                    html += `
                        <tr>
                            <td>${new Date(item.fechaHora).toLocaleString('es-ES')}</td>
                            <td>${item.operacion}</td>
                            <td>${exito}</td>
                        </tr>`;
                });

                html += '</tbody></table>';
                $('#actividadContent').html(html);
            }).fail(function() {
                $('#actividadContent').html('<p class="text-danger">Error al cargar el historial de actividad.</p>');
            });
        });
    });
</script>
